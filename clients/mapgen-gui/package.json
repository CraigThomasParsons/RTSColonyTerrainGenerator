{
  "name": "mapgen-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-only prototype GUI for MapGen.Api (React + TypeScript, Feature-Sliced Design, capybara_2d_engine preview).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
