{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtscolony.local/schemas/pixellab/candidate-approval-v1.json",
  "title": "PixelLab Candidate Approval Record v1",
  "description": "Append-only history of explicit local operator decisions for one candidate. Automation may never write a human-approved decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "approvalVersion", "planId", "candidateIndex", "seed", "currentState", "decisions"],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "approvalVersion": {"const": "1"},
    "planId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidateIndex": {"type": "integer", "minimum": 0},
    "seed": {"type": "integer"},
    "currentState": {"enum": ["human-approved", "rejected"]},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "decision", "actor", "actorKind", "recordedAt", "reason", "previousState", "evidence"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "decision": {"enum": ["human-approved", "rejected"]},
          "actor": {"type": "string", "minLength": 1},
          "actorKind": {"const": "operator"},
          "recordedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "reason": {"type": "string", "minLength": 1},
          "previousState": {"enum": ["planned", "dry-run", "processing", "generated", "rejected", "human-approved"]},
          "evidence": {
            "type": "object",
            "required": ["validationReportSha256", "controlInputs", "planId"],
            "properties": {
              "validationReportSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "candidateImageSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
              "controlInputs": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
              "requestCacheKey": {"type": ["string", "null"]},
              "planId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "sourceSha256": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
