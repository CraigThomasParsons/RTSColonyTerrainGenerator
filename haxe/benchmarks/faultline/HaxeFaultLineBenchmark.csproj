<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the fault-line benchmark's cs-target output (generated-cs/,
    gitignored, rebuilt by `haxe benchmarks/faultline/build-cs.hxml`) the
    same way haxe/stages/tiler/HaxeTilerPilot.csproj does: plain dotnet
    build on net10.0, bypassing hxcs's own legacy mono/csc invocation.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HaxeFaultLineBenchmark</AssemblyName>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0109;CS0114;CS0219;CS0429;CS0168;CS0162;CS0252;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="generated-cs/src/**/*.cs" />
  </ItemGroup>

</Project>
