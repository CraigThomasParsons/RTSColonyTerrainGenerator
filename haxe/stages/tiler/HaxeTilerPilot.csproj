<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles stage-tiler's Haxe output (generated-cs/, gitignored, rebuilt by
    `haxe stages/tiler/build-cs.hxml`) on the modern SDK toolchain instead of
    the hxcs haxelib's own legacy mono/csc invocation (haxe/README.md "Known
    toolchain limitation"). This project file is the hand-maintained adapter;
    every *.cs it compiles is generated output, never edited directly.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HaxeTilerPilot</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Haxe's cs-target output predates nullable/implicit-usings conventions
         and triggers warnings-as-suggestions this project doesn't need. -->
    <NoWarn>CS0109;CS0114;CS0219;CS0429;CS0168;CS0162;CS0252;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="generated-cs/src/**/*.cs" />
  </ItemGroup>

</Project>
